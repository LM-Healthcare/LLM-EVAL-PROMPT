# Copy to .env (never commit .env) and fill in. Read automatically by docker compose.

# --- API keys -------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# optional Hugging Face token (authenticated, faster model download)
HF_TOKEN=

# --- your user on the host, so files in results/ are owned by you ---------
# values from: id -u   and   id -g
HOST_UID=1000
HOST_GID=1000

# --- vLLM server ----------------------------------------------------------
# use vllm/vllm-openai:nightly if :latest does not recognise Qwen3.5;
# pin an exact version tag before the main run and keep it for all runs
VLLM_IMAGE=vllm/vllm-openai:latest
QWEN_MODEL=Qwen/Qwen3.5-9B
# 8192 for main/triage experiments, 20480 for the native-reasoning arm
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.92
VLLM_PORT=8000
# Hugging Face cache on the host (default ~/.cache/huggingface, shared with your other projects)
# HF_CACHE=/data/hf-cache
